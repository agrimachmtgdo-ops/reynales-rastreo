# Copie este archivo como .env.local y complete los valores de su proyecto Supabase
# (Supabase → Project Settings → API). La clave "publishable"/"anon" es pública:
# la seguridad la dan las políticas RLS de la base de datos.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Enlace de descarga de la app del chofer (Google Play, prueba cerrada). Se incluye en el mensaje de WhatsApp.
NEXT_PUBLIC_ENLACE_APP_CHOFER=https://play.google.com/store/apps/details?id=bo.reynales.chofer

# Mapa «Carreteras» (CARTO Voyager). Clave gratuita en https://carto.com/basemaps/apikey/
# Sin clave, los mapas usan OpenStreetMap clásico.
NEXT_PUBLIC_CARTO_KEY=
