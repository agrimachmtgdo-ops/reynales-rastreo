{
  "expo": {
    "name": "Reynales Chofer",
    "slug": "reynales-chofer",
    "owner": "industrias-reynales-bo",
    "version": "0.1.2",
    "scheme": "reynaleschofer",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "android"
    ],
    "backgroundColor": "#FBF6EC",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF6EC"
    },
    "android": {
      "package": "bo.reynales.chofer",
      "versionCode": 3,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "La app registra la ubicación del camión solo entre \"Iniciar viaje\" y \"Entregado\".",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "La cámara se usa para escanear el código QR de la invitación.",
          "recordAudioAndroid": false
        }
      ],
      "expo-sqlite",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "4a432b08-e7d9-449a-b2fb-5d37901d8255"
      }
    }
  }
}
